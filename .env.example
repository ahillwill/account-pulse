# Copy to .env for local runs. Never commit .env. On GitHub, add these as repository secrets instead.

# Claude agent (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# News (gnews.io, free tier)
GNEWS_API_KEY=

# SEC EDGAR asks for a contact email in the User-Agent (no key needed)
SEC_CONTACT_EMAIL=

# Email digest (Gmail: turn on 2-Step Verification, then create an App Password)
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
# Optional: link to your GitHub Pages dashboard, shown in the email
DASHBOARD_URL=
